{
  "name": "pinlocate-site",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/csp.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "links": "node scripts/check-links.mjs",
    "serve": "node scripts/serve.mjs",
    "e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test --grep @pages",
    "lighthouse": "node scripts/lighthouse.mjs",
    "og": "node scripts/og.mjs",
    "check:fast": "npm run lint && npm run typecheck && npm test && npm run build && npm run links && npm run schema",
    "check": "npm run check:fast && npm run e2e && npm run lighthouse",
    "schema": "node scripts/validate-schema.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@adobe/structured-data-validator": "1.7.0",
    "@axe-core/playwright": "^4.14.0",
    "@marbec/web-auto-extractor": "2.2.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.9"
  }
}
